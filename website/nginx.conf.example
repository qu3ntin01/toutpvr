# ToutPVR — exemple de vhost nginx (PHP-FPM 8.2+)
server {
    listen 443 ssl http2;
    server_name toutpvr.example;
    root /var/www/toutpvr/website/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/toutpvr.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/toutpvr.example/privkey.pem;

    client_max_body_size 620m;      # upload des releases (≤ 512 Mo)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location ~* \.(css|js|svg|png|jpg|webp|woff2)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_read_timeout 120;
    }

    # Ne jamais exposer config/, storage/, app/, etc. (ils sont hors de public/, ceci est une ceinture de sécurité)
    location ~ /\.(?!well-known) { deny all; }
    location ~* \.(key|lock|sqlite|log)$ { deny all; }
}

server {
    listen 80;
    server_name toutpvr.example;
    return 301 https://$host$request_uri;
}
