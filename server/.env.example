# ToutPVR — variables d'environnement (préfixe TP_). Copier en .env ou exporter.
# Fichier de configuration YAML (défaut : ~/.toutpvr/config.yaml)
TP_CONFIG=/etc/toutpvr/config.yaml
# Répertoire des données (base SQLite, enregistrements, événements, journaux, sauvegardes)
TP_DATA_DIR=/var/lib/toutpvr
# Base de données : sqlite (défaut) ou mysql+pymysql://user:mdp@hote/toutpvr
TP_DB_URL=sqlite:////var/lib/toutpvr/toutpvr.db
TP_HOST=0.0.0.0
TP_PORT=8080
# Clé secrète (JWT, chiffrement Fernet). Générée automatiquement si vide.
TP_SECRET_KEY=
# Portail de licence / mises à jour
TP_PORTAL_URL=https://toutpvr.example
# Clé publique Ed25519 (base64, 32 octets) — celle de développement par défaut, à remplacer en production
TP_LICENSE_PUBLIC_KEY=KBBimt/p+ELJhmk4teAIrUGNcSW6pje1IH2u2O+iSQE=
TP_LANG=fr
TP_LOG_LEVEL=info
TP_RECORDINGS_QUOTA_GB=50
TP_DEFAULT_RETENTION_DAYS=7
TP_UPDATE_CHANNEL=stable
TP_COOKIE_SECURE=false
# Compte propriétaire créé au premier démarrage si la base est vide
TP_ADMIN_USER=admin
TP_ADMIN_PASSWORD=ChangeMe12345!
TP_ADMIN_EMAIL=
# Caméra de démonstration au démarrage
TP_DEMO=false
